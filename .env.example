# ---- Server ----
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins. Set this in production.
ALLOWED_ORIGINS=http://localhost:3000,https://neohives.com

# ---- Auth (single non-expiring frontend token) ----
# Backend secret. Generate both secret and token with: npm run token -- --secret
# NEVER ship this value to the browser — only the minted JWT goes in the frontend.
JWT_SECRET=
JWT_ISSUER=neohives.com
JWT_AUDIENCE=neohives-chatbot
# Comma-separated jti values to reject (kills a leaked token without rotating the secret).
REVOKED_TOKEN_IDS=

# ---- Conversation state (stored in the browser's localStorage) ----
# Signs the state blob so the client can't forge history or edit its own lead.
# Defaults to JWT_SECRET when blank; a separate value is better (rotate independently).
STATE_SECRET=
MAX_HISTORY_MESSAGES=30
# Hard cap on turns per conversation — the frontend token is public, so this
# limits what a single abusive client can spend.
MAX_TURNS_PER_CONVERSATION=40
MAX_STATE_BYTES=128000

# ---- OpenAI (ChatGPT API) ----
OPENAI_API_KEY=sk-...
# gpt-4o-mini is cheap and fast; swap for gpt-4o / gpt-4.1 for better reasoning.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_OUTPUT_TOKENS=700
# Set to true to run the bot with a canned reply instead of calling OpenAI (no key needed).
MOCK_LLM=false

# ---- Lead webhook (n8n / Zapier / Make / your CRM endpoint) ----
# Optional. Receives the full nested JSON payload. Leave blank to use Formspree only.
LEAD_WEBHOOK_URL=
# Optional. If set, requests are signed: X-Neohives-Signature: sha256=<hmac hex>
LEAD_WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=3

# ---- Formspree (lead → sales inbox) ----
# Delivered to independently of LEAD_WEBHOOK_URL, with a flattened, email-friendly
# payload. The lead is sent as soon as the chat has an email + a service interest.
# Named NEXT_PUBLIC_* to match the website's env file — despite the prefix this is
# read only by this backend and is never exposed to the browser.
NEXT_PUBLIC_FORMSPREE_WEBHOOK=https://formspree.io/f/myeyjqpa
# Follow-up `lead.updated` sends per conversation, for detail given after the
# first submission (budget, volumes, timeline). 0 disables them.
WEBHOOK_MAX_LEAD_UPDATES=3

# ---- Ops ----
LOG_LEVEL=info
# Requests per window, per IP, on /api/chat
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
